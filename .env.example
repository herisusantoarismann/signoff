# Supabase Project (Public URL & Anon Key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-Only Secrets (NEVER expose in NEXT_PUBLIC_* or Client Components)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GUEST_SESSION_SECRET=replace-with-at-least-32-random-characters-for-hmac-jwt
IP_HASH_SECRET=replace-with-random-secret-for-join-rate-limit
